{
  "name": "weasley-deepmind",
  "version": "1.0.0",
  "description": "A secure, fragment-based memory MCP server from Weasley Open Source.",
  "type": "module",
  "main": "server.js",
  "exports": "./server.js",
  "bin": {
    "weasley-deepmind": "bin/weasley-deepmind.js"
  },
  "files": [
    "assets",
    "bin",
    "config",
    "docs",
    "lib",
    "scripts",
    ".env.example",
    ".env.example.minimal",
    "server.js",
    "server.json",
    "setup.sh",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "cross-env DOTENV_CONFIG_PATH=.env.test WEASLEY_DEEPMIND_METRICS_DEFAULT=off REDIS_ENABLED=false CACHE_ENABLED=false node --experimental-test-module-mocks --test tests/unit/*.test.js tests/unit/**/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js tests/e2e/*.test.js",
    "test:integration:llm": "cross-env WEASLEY_DEEPMIND_METRICS_DEFAULT=off node --test --test-concurrency=1 tests/integration/llm-cli-smoke.test.js tests/integration/llm-timeout.test.js tests/integration/morpheme-llm-real.test.js tests/integration/llm-chain-real.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js",
    "test:e2e:local": "bash scripts/run-e2e-tests.sh",
    "test:ci": "npm test && npm run test:integration",
    "lint": "eslint .",
    "backfill:embeddings": "node scripts/backfill-embeddings.js",
    "lint:migrations": "node scripts/lint-migrations.js",
    "migrate": "node scripts/migrate.js",
    "cli": "node bin/weasley-deepmind.js"
  },
  "mcpName": "io.github.potatohoney-p/weasley-deepmind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/potatohoney-p/weasley-deepmind.git"
  },
  "bugs": {
    "url": "https://github.com/potatohoney-p/weasley-deepmind/issues"
  },
  "homepage": "https://github.com/potatohoney-p/weasley-deepmind#readme",
  "author": "Weasley Open Source <potatohoney.p@gmail.com>",
  "license": "Apache-2.0",
  "keywords": [
    "weasley",
    "mcp",
    "model-context-protocol",
    "memory",
    "agents",
    "ai"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@node-rs/jieba": "^2.0.1",
    "dotenv": "^16.0.0",
    "garu-ko": "^0.9.1",
    "ioredis": "^5.9.3",
    "js-tiktoken": "^1.0.21",
    "kuromoji": "^0.1.2",
    "natural": "^8.1.1",
    "node-fetch": "^3.3.2",
    "openai": "^6.21.0",
    "pg": "^8.18.0",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.8.1 <5"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.0.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
